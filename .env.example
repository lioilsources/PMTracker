# Zkopíruj na .env a doplň z Supabase dashboardu:
#   Project Settings → API Keys
# .env je v .gitignore — klíče se nikdy nedostanou do repozitáře.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "Publishable key" — bezpečný pro klienta, chrání ho RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "Secret key" — OBCHÁZÍ RLS. Používá ho jen scripts/create-test-users.mjs
# při zakládání testovacích účtů. Nikdy nepatří do appky ani do gitu.
SUPABASE_SECRET_KEY=sb_secret_...

# Heslo k Postgresu (zadané při zakládání projektu; reset v Project Settings → Database).
# Používá ho Supabase CLI pro `supabase link` a `supabase db push`.
SUPABASE_DB_PASSWORD=
